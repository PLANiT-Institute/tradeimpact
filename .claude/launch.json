{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "script/auto/serve_dashboard.py"
      ],
      "port": 8765
    },
    {
      "name": "power",
      "runtimeExecutable": ".venv/bin/python",
